# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server port (default: 3000)
PORT=3000

# DATABASE_URL: PostgreSQL (schema "ipls"). Com ela definida, o iPLS grava no banco;
# sem ela, usa o arquivo ./data/database.json. No docker-compose, já é definida para o
# serviço "postgres". Para rodar fora do compose apontando para o banco do compose:
DATABASE_URL="postgresql://ipls_admin:<senha-do-banco>@localhost:5433/ipls_db"

# POSTGRES: Variables for docker-compose postgres container
POSTGRES_DB="ipls_db"
POSTGRES_USER="ipls_admin"
POSTGRES_PASSWORD="<senha-do-banco>"
IPLS_PG_PORT=5433
# Porta do iPLS no host (docker-compose)
IPLS_PORT=3100

# LOCAL_AI_ENDPOINT: Optional default endpoint for On-Premise SJRR AI
LOCAL_AI_ENDPOINT="http://localhost:11434/v1"


# =========================================================================
# AUTENTICAÇÃO (AD da floresta trf1.gov.br) E PERMISSÕES
# O AD só autentica (senha de rede). As permissões são concedidas no próprio
# iPLS, na tela "Usuários e Permissões" (administrador → master → preenchedor).
# Visitantes consultam os painéis sem login.
# =========================================================================
# ldap (produção) | dev (teste local sem AD, com senha única)
AUTH_MODE="ldap"
# Segredo para assinar a sessão (obrigatório em produção). Gere com: openssl rand -hex 32
SESSION_SECRET=""
SESSION_HOURS=8
# true quando o iPLS estiver atrás de HTTPS (proxy reverso)
COOKIE_SECURE="false"
TRUST_PROXY="false"
# Domínio usado quando o usuário digita só "usuario"
AUTH_DEFAULT_DOMAIN="rr.trf1.gov.br"
AUTH_DOMAIN_SUFFIX="trf1.gov.br"

# Primeiros administradores regionais (separados por vírgula). Os demais
# acessos são concedidos pela tela.
IPLS_ADMINS="<usuario>@<secao>.trf1.gov.br"

# Catálogo Global por LDAPS (3269) num controlador de domínio da SJRR.
# O login é validado com as credenciais do próprio usuário (JFBA\usuario).
LDAP_URL="ldaps://<controlador-de-dominio>:3269"
# OPCIONAL: conta de serviço somente leitura, só para mostrar o nome completo
# ao conceder acesso a quem ainda não entrou no iPLS.
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
# Cadeia da AC interna do TRF1 (AC Raiz TRF1 + AC Subordinada 1), em ./certs
LDAP_TLS_CA_FILE="/app/certs/ac-trf1.pem"
LDAP_TLS_REJECT_UNAUTHORIZED="true"

# Somente para AUTH_MODE=dev (nunca em produção real)
AUTH_DEV_PASSWORD=""
AUTH_ALLOW_DEV_IN_PRODUCTION="false"
